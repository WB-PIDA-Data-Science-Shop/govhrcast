Package: govhrcast
Title: Government Wage Bill Forecasting and Simulation
Authors@R: c(
    person("Ifeanyi", "Edochie", , "iedochie@worldbank.org", role = c("aut", "cre")),
    person("Galileu", "Kim", , "galileukim@worldbank.org", role = c("aut"))
